{
  "name": "dsh-remote-web-ui-standalone",
  "private": true,
  "version": "0.4.13",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "Standalone workspace for @linxin666/dsh-remote-web-ui, split out of the dsh-web monorepo",
  "main": "./packages/dsh-remote-web-ui/lib/index.js",
  "types": "./packages/dsh-remote-web-ui/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/dsh-remote-web-ui/lib/types/index.d.ts",
      "default": "./packages/dsh-remote-web-ui/lib/index.js"
    },
    "./client": {
      "types": "./packages/dsh-remote-web-ui/lib/types/client/index.d.ts",
      "default": "./packages/dsh-remote-web-ui/lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "node -e \"require('fs').rmSync('packages/dsh-remote-web-ui/lib',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "lightningcss": "^1.30.2",
    "simple-icons": "^13.21.0",
    "tsdown": "^0.22.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
