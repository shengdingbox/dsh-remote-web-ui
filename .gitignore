# 依赖
node_modules/

# 构建产物（例外：本包仓库自带预构建 lib，见 README「预构建产物」）
packages/*/lib/
!/packages/dsh-remote-web-ui/lib/
# 随仓只放 js 产物；类型声明与 sourcemap 由本地构建生成，不入库
packages/dsh-remote-web-ui/lib/types/
packages/dsh-remote-web-ui/lib/**/*.map
*.tsbuildinfo

# 测试与覆盖率
coverage/
test-results/
playwright-report/

# 本地环境与凭据（严禁提交）
.npmrc
.env
.env.*
!.env.example

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.log

# 本地远程访问运行时数据（配对令牌、隧道状态，含机密）
.dsh/
